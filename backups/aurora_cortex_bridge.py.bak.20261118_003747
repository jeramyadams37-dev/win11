import os, sqlite3, json, urllib.request
from flask import Flask, request, jsonify

app = Flask(__name__)
DB_PATH = "/data/data/com.termux/files/home/AuroraOS/aurora.db"
GEMINI_MODEL = "gemini-2.0-flash"

@app.after_request
def add_cors(resp):
    resp.headers["Access-Control-Allow-Origin"] = "*"
    resp.headers["Access-Control-Allow-Headers"] = "Content-Type, Authorization"
    resp.headers["Access-Control-Allow-Methods"] = "GET, POST, OPTIONS"
    return resp

def inspect_db():
    if not os.path.exists(DB_PATH):
        return None, {}
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    tables = [r[0] for r in cur.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall()]
    counts = {}
    for t in tables:
        try:
            counts[t] = cur.execute(f'SELECT COUNT(*) FROM "{t}"').fetchone()[0]
        except Exception:
            counts[t] = -1
    conn.close()
    return DB_PATH, counts

@app.route("/api/status", methods=["GET", "OPTIONS"])
def status():
    if request.method == "OPTIONS":
        return ("", 204)
    path, counts = inspect_db()
    return jsonify({"status": "online", "db_found": bool(path), "db_path": DB_PATH, "tables": counts, "model": GEMINI_MODEL})

@app.route("/api/chat", methods=["POST", "OPTIONS"])
def chat():
    if request.method == "OPTIONS":
        return ("", 204)
    data = request.get_json(silent=True) or {}
    prompt = (data.get("message") or data.get("prompt") or "").strip()
    path, counts = inspect_db()

    # Pull relevant database context if aurora.db exists
    db_context = ""
    if path:
        try:
            conn = sqlite3.connect(DB_PATH)
            cur = conn.cursor()
            terms = [w for w in prompt.lower().split() if len(w) > 2 and w not in {"the", "and", "for", "with"}]
            hits = []
            for t in counts:
                if counts[t] <= 0: continue
                cols = [c[1] for c in cur.execute(f'PRAGMA table_info("{t}")').fetchall()]
                if not cols: continue
                where = " OR ".join([f'LOWER(CAST("{c}" AS TEXT)) LIKE ?' for c in cols])
                rows = cur.execute(f'SELECT * FROM "{t}" WHERE {where} LIMIT 2', [f"%{terms[0]}%"] * len(cols) if terms else []).fetchall()
                for r in rows:
                    hits.append(f"[{t}] " + " | ".join(str(x)[:60] for x in r if x is not None))
            conn.close()
            if hits: db_context = "Relevant DB context:\n" + "\n".join(hits[:4])
        except Exception:
            pass

    # Return synthesized local Cortex response
    reply = f"Cortex [{GEMINI_MODEL}]: Processed query '{prompt}'.\n{db_context}"
    return jsonify({"response": reply.strip()})

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=8420)
