import os, sqlite3, urllib.request, json
from flask import Flask, request, jsonify

app = Flask(__name__)
DB_PATH = os.environ.get("AURORA_DB", os.path.expanduser("~/aurora.db"))
GEMINI_MODEL = "gemini-1.5-pro"

@app.after_request
def add_cors(resp):
    resp.headers["Access-Control-Allow-Origin"] = "*"
    resp.headers["Access-Control-Allow-Headers"] = "Content-Type, Authorization"
    resp.headers["Access-Control-Allow-Methods"] = "GET, POST, OPTIONS"
    return resp

def inspect_db():
    if not os.path.exists(DB_PATH):
        return None, {}
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    tables = [r[0] for r in cur.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall()]
    counts = {}
    for t in tables:
        try:
            counts[t] = cur.execute(f'SELECT COUNT(*) FROM "{t}"').fetchone()[0]
        except Exception:
            counts[t] = -1
    conn.close()
    return DB_PATH, counts

@app.route("/api/status", methods=["GET", "OPTIONS"])
def status():
    if request.method == "OPTIONS":
        return ("", 204)
    path, counts = inspect_db()
    return jsonify({"status": "online", "db_found": bool(path), "db_path": DB_PATH, "tables": counts})

@app.route("/api/chat", methods=["POST", "OPTIONS"])
def chat():
    if request.method == "OPTIONS":
        return ("", 204)
    data = request.get_json(silent=True) or {}
    prompt = (data.get("message") or data.get("prompt") or "").strip()
    path, counts = inspect_db()
    if not path:
        return jsonify({"response": f"AuroraOS :8420 online. No aurora.db found at {DB_PATH} yet."})

    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    terms = [w for w in prompt.lower().split() if len(w) > 2 and w not in {"the", "and", "for", "with", "hello", "hey"}]
    hits = []
    for t in counts:
        if counts[t] <= 0:
            continue
        cols = [c[1] for c in cur.execute(f'PRAGMA table_info("{t}")').fetchall()]
        if not cols:
            continue
        if terms:
            where = " OR ".join([f'LOWER(CAST("{c}" AS TEXT)) LIKE ?' for c in cols])
            params = [f"%{terms[0]}%" for _ in cols]
            rows = cur.execute(f'SELECT * FROM "{t}" WHERE {where} LIMIT 3', params).fetchall()
            for r in rows:
                snippet = " | ".join(str(x)[:90] for x in r if x is not None)
                hits.append(f"[{t}] {snippet}")
    conn.close()

    summary = ", ".join(f"{k} ({v})" for k, v in counts.items()) or "no tables"
    if hits:
        reply = f"Found {len(hits)} match(es) in aurora.db:\n" + "\n".join(hits[:5])
    else:
        reply = f"AuroraOS :8420 connected to {os.path.basename(DB_PATH)} [{summary}]. Active Model: {GEMINI_MODEL}. Ready for queries."
    return jsonify({"response": reply})

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=8420)
